# ==============================================================================
# Plant Disease Detection - Environment & Security Configuration
# Follows the 80/20 of Vibe Coding Security (Pillars 1 - 5)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Mode
# ------------------------------------------------------------------------------
# 'development' allows local unauthenticated requests with security warning headers.
# 'production' strictly enforces authentication and restricts CORS origins.
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. Authentication & Authorization Middleware (Rule 5)
# ------------------------------------------------------------------------------
# Client API Key required in 'X-API-Key' or 'Authorization: Bearer <key>'
PLANT_API_KEY=

# Admin key for privileged health & inspection operations
ADMIN_API_KEY=

# ------------------------------------------------------------------------------
# 3. Server-Side Protection: Rate Limiting & Upload Caps (Rule 3)
# ------------------------------------------------------------------------------
# Allowed requests per minute per IP / API key (prevents DoS and token drain)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=15

# Max upload payload in bytes (default 10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 4. CORS Origins (Strict Origin Whitelisting)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed web frontend URLs (disallows '*' in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 5. External LLM & RAG Provider (Rule 1: Secrets kept strictly server-side)
# ------------------------------------------------------------------------------
# OpenRouter API key for multimodal vision fallback and literature RAG reasoning
# Never expose this key in frontend code or client bundles.
OPENROUTER_API_KEY=
